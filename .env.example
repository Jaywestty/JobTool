# Copy to .env and fill in. Never commit .env.
# Every value below is read by docker compose and passed to the backend.

# --- Postgres ---------------------------------------------------------------
# Credentials for the local Postgres container. Any non-empty value works for
# a local stack; use real secrets in a hosted deployment.
POSTGRES_USER=jobtool
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=jobtool
# Host port for Postgres. Change if 5432 is taken.
POSTGRES_PORT=5432

# --- Host ports -------------------------------------------------------------
# Host port for the backend API.
BACKEND_PORT=8080
# Host port for the Next.js web app.
WEB_PORT=3000

# --- Application ------------------------------------------------------------
# development | staging | production. Informational only.
JOBTOOL_APP_ENV=development
# debug | info | warn | error
JOBTOOL_LOG_LEVEL=info
# Origin allowed by CORS. Use the public web URL in production.
JOBTOOL_WEB_ORIGIN=http://localhost:3000

# --- Role families (required) ----------------------------------------------
# A JSON array of {slug, keywords}. Keywords are matched while classifying a
# posting into a family. Add or remove families here, never in code.
JOBTOOL_ROLE_FAMILIES=[{"slug":"backend","keywords":["backend","back-end","api engineer","server-side"]},{"slug":"ai_ml","keywords":["machine learning","ml engineer","ai engineer","nlp","computer vision","llm","data scientist"]},{"slug":"data","keywords":["data engineer","data analyst","analytics engineer","etl","data warehouse"]},{"slug":"frontend","keywords":["frontend","front-end","ui engineer","react developer"]},{"slug":"fullstack","keywords":["fullstack","full-stack","full stack"]},{"slug":"devops","keywords":["devops","sre","platform engineer","infrastructure","site reliability"]},{"slug":"mobile","keywords":["mobile engineer","ios","android","react native","flutter"]},{"slug":"security","keywords":["security engineer","appsec","penetration tester","soc analyst"]},{"slug":"qa","keywords":["qa engineer","quality assurance","test automation","sdet"]}]

# --- Embeddings -------------------------------------------------------------
# local | openai_compatible. "local" needs no API key and is the baseline.
JOBTOOL_EMBEDDING_PROVIDER=local
# Model identifier recorded on every embedding row.
JOBTOOL_EMBEDDING_MODEL=local-hash-v1
# Vector dimension. Must match the model and the HNSW index expression
# dimension (768 in the bundled migration). Change both together.
JOBTOOL_EMBEDDING_DIM=768

# --- Optional LLM -----------------------------------------------------------
# none | ollama | openai_compatible. "none" uses the no-key baseline and is the
# default. Setting a provider requires BASE_URL and MODEL.
JOBTOOL_LLM_PROVIDER=none
# e.g. http://host.docker.internal:11434 for Ollama on the host, or any
# OpenAI-compatible base URL.
JOBTOOL_LLM_BASE_URL=
# API key for hosted providers. Leave empty for Ollama. Never commit a key.
JOBTOOL_LLM_API_KEY=
# e.g. llama3.1 or gpt-4o-mini
JOBTOOL_LLM_MODEL=
# Request timeout in seconds, 1-600.
JOBTOOL_LLM_TIMEOUT_S=30

# --- Digests ----------------------------------------------------------------
# daily | every_3_days | weekly. Default for new users.
JOBTOOL_DIGEST_DEFAULT_FREQUENCY=weekly
# Hour in the user's timezone, 0-23.
JOBTOOL_DIGEST_SEND_HOUR=8

# --- Job sources ------------------------------------------------------------
# User agent sent to public job feeds.
JOBTOOL_SOURCES_USER_AGENT=jobtool/0.1
# Source fetch timeout in seconds, 1-300.
JOBTOOL_SOURCES_TIMEOUT_S=30
